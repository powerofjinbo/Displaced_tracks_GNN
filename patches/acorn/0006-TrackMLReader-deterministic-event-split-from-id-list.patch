 import os
+import warnings
 import numpy as np
+import torch
 from torch.utils.data import random_split
 import trackml.dataset
 
 from ..data_reading_stage import EventReader
 from . import trackml_utils
 
+INPUT_TERMS = ["truth", "hits", "particles", "cells"]
+SPLIT_NAMES = ("trainset", "valset", "testset")
+
+
+def read_event_id_list(path):
+    """Read event ids from a text file: one integer per line, '#' starts a comment."""
+    ids = []
+    with open(os.path.expanduser(os.path.expandvars(path))) as f:
+        for line in f:
+            line = line.split("#", 1)[0].strip()
+            if line:
+                ids.append(int(line))
+    if len(set(ids)) != len(ids):
+        raise ValueError(f"Duplicate event ids in {path}")
+    return ids
+
 
 class TrackMLReader(EventReader):
