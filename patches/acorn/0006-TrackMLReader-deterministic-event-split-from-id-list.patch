+    def _split_events(self, events):
+        """Deterministic train/val/test split.
+
+        With `split_lists: {trainset: a.txt, valset: b.txt, testset: c.txt}` each
+        set holds exactly the listed event ids (in file order); a listed id without
+        all four input files raises, and the lists must be disjoint. Omitted sets
+        are empty. Without `split_lists`, complete events sorted by id are split
+        80/10/10 with a generator seeded by `split_seed` (default 0), replacing
+        the unseeded random_split, whose result also depended on glob order.
+        """
+        complete = {
+            int(e["event_id"]): e for e in events if all(t in e for t in INPUT_TERMS)
+        }
+        n_incomplete = len(events) - len(complete)
+        split_lists = self.config.get("split_lists")
+
+        if not split_lists:
+            if n_incomplete:
+                warnings.warn(f"Dropping {n_incomplete} events with missing input files")
+            ordered = [complete[i] for i in sorted(complete)]
+            n_train, n_val = int(len(ordered) * 0.8), int(len(ordered) * 0.1)
+            generator = torch.Generator().manual_seed(int(self.config.get("split_seed", 0)))
+            return random_split(
+                ordered,
+                [n_train, n_val, len(ordered) - n_train - n_val],
+                generator=generator,
+            )
+
+        unknown = set(split_lists) - set(SPLIT_NAMES)
+        if unknown:
+            raise ValueError(f"split_lists keys must be in {SPLIT_NAMES}, got {unknown}")
+        splits, seen = [], set()
+        for name in SPLIT_NAMES:
+            ids = read_event_id_list(split_lists[name]) if split_lists.get(name) else []
+            missing = [i for i in ids if i not in complete]
+            if missing:
+                raise FileNotFoundError(
+                    f"{name}: {len(missing)} listed events lack input files in"
+                    f" {self.config['input_dir']}, e.g. {missing[:5]}"
+                )
+            overlap = seen.intersection(ids)
+            if overlap:
+                raise ValueError(f"{name} overlaps another split: {sorted(overlap)[:5]}")
+            seen.update(ids)
+            splits.append([complete[i] for i in ids])
+        return splits
+
