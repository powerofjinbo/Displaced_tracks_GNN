 from .version_utils import get_pyg_data_keys
 
 
+def flatten_event_id(event_id):
+    """Return the event id as a plain string.
+
+    DataLoader collation wraps string attributes in a list at every stage that
+    batches events, so after metric learning and the GNN an event_id can be
+    [['000021009']]. Unwrap any nesting of lists/tuples; reject empty or
+    multi-event containers instead of guessing.
+    """
+    while isinstance(event_id, (list, tuple)):
+        if len(event_id) != 1:
+            raise ValueError(f"Expected a single event id, got {event_id!r}")
+        event_id = event_id[0]
+    return str(event_id)
+
+
